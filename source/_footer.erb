  <footer class="bg-blue-dark text-gray-light text-sm md:text-base lg:text-xl leading-snug">

<%# start brevo_form_html %>
    <%= partial "brevo_form_html" %>
<%# end brevo_form_html %>

    <div class="container mx-auto px-4 lg:px-16 py-4 lg:py-12">
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4">
        <div class="col-start-1">
          <p class="mb-2">
            Flight Free UK<br>
            125 High Oak Road<br>
            SG12 7PA
          </p>
          <p class="mb-2">
            Registered charity <a href="https://register-of-charities.charitycommission.gov.uk/charity-search/-/charity-details/5199421" target="_blank" class="hover:text-orange">1199328</a>
          </p>
        </div>
        <div class="col-start-2 sm:col-span-2 sm:grid sm:grid-cols-2 md:pl-8">
          <nav class="sm:col-start-1">
            <p class="block text-right md:text-left">Contact:<br>
            <%= link_to "info@flightfree.co.uk", "mailto:info@flightfree.co.uk", class: "md:block text-right md:text-left hover:text-orange" %>
            </p>
          </nav>
          <nav class="sm:col-start-2">
            <%= link_to "Resources", "/resources.html", class: "block text-right md:text-left md:pl-8 hover:text-orange" %>
            <%= link_to "Terms and conditions", "/terms_and_conditions.html", class: "block text-right md:text-left md:pl-8 hover:text-orange" %>
            <%= link_to "Privacy Policy", "/privacy_policy.html", class: "block text-right md:text-left md:pl-8 hover:text-orange" %>
          </nav>
          </div>
        <div class="col-start-1 row-start-2 col-span-full lg:col-start-4 lg:row-start-1">
          <p class="">
            <img src="/images/1-percent-planet-logo.png" alt="Approved partner of 1 percent for the planet" loading="lazy" class="block w-140 h-auto mr-auto lg:mr-0 ml-auto my-4"/>
          </p>
          </div>
        </div>
        <div class="col-span-full row-start-2 sm:col-span-1 sm:col-start-2 sm:row-start-1 md:col-span-full md:col-start-1 md:row-start-2">
          <nav class="social-sharing flex flex-wrap justify-center">
			<% 
			{
         		"facebook" => "https://facebook.com/",
         		"instagram" => "https://instagram.com/",
         		"bluesky" => "https://bsky.app/profile/",
         		"linkedin" => "https://www.linkedin.com/company/",
         		"tiktok" => "https://www.tiktok.com/@"
       		}.each do |name, path| %>
				<% if data.social_media[name] %>
            <a href="<%= path %><%= data.social_media[name] %>" class="w-8 h-8 md:w-12 md:h-12 flex justify-center bg-blue-dark border border-gray-light hover:border-orange rounded-full mx-2" target="_blank">
            	<%= partial "svg/icon-#{name}-circle.svg" %>
            </a>
				<% end %>
			<% end %>
          </nav>
        </div>
      </div>
    </div>
  </footer>
