<section class="section--why bg-gray-light text-blue-dark px-4">
  <div class="container mx-auto lg:px-16 pt-12 pb-8">
    <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-center">Why?</h2>
  </div>
  <div class="container mx-auto md:flex justify-center items-center xl:px-16 pb-8">
    <div class="mb-8 px-4 text-xl lg:text-2xl xl:text-4xl md:flex justify-center gap-4 xl:gap-12">
      <div class="flex flex-col items-center max-w-316">
        <img src="/images/Why-for_the_climate-426x426b.jpg" width="426" height="426" alt="Image for the climate" id="why-image-1" loading="lazy" class="w-288 max-w-316 md:w-auto mx-auto" />
        <h3 class="mb-4 py-2 md:py-4 text-center leading-snug"><%= partial "svg/dot_pink.svg" %> <a href="/post/what-has-aviation-got-to-do-with-climate-change/" class="border-b-4 border-orange hover:border-blue-dark">For the climate</a></h3>
      </div>
      <div class="flex flex-col items-center max-w-316">
        <img src="/images/Why-to_inspire_social_change-426x426.jpg" width="426" height="426" alt="Image to inspire social change" id="why-image-2" loading="lazy" class="w-288 max-w-316 md:w-auto mx-auto" />
        <h3 class="mb-4 py-2 md:py-4 text-center text-center leading-snug"><%= partial "svg/dot_pink.svg" %> <a href="/post/can-i-really-make-a-difference/" class="border-b-4 border-orange hover:border-blue-dark">To inspire social change</a></h3>
      </div>
      <div class="flex flex-col items-center max-w-316">
        <img src="/images/Why-to_influence_system_change-426x426.jpg" width="426" height="426" alt="Image to influence system change" id="why-image-3" loading="lazy" class="w-288 max-w-316 md:w-auto mx-auto" />
        <h3 class="mb-4 py-2 md:py-4 text-center text-center leading-snug"><%= partial "svg/dot_pink.svg" %> <a href="/post/individual-action-vs-system-change/" class="border-b-4 border-orange hover:border-blue-dark">To influence system change</a></h3>
      </div>
    </div>
  </div>
  <div class="container mx-auto lg:px-16">
    <p>
      <% link_to "/why_flight_free/", class: "block text-right flex justify-end items-center pt-1 pb-8 font-bold text-lg xl:text-2xl hover:text-orange" do %>
        Find out more <img src="/svg/orange_arrow_right.svg" alt="arrow graphic" width="44" height="44" class="inline-block w-8 sm:w-10 h-auto ml-2" />
      <% end %>
    </p>
  </div>
</section>
