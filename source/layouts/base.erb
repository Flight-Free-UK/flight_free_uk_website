<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <link rel="preload" as="font" href="/fonts/Kollektif.woff2" type="font/woff2" crossorigin />

  <% title = [current_page.data.title, "Flight Free UK"].compact.uniq.join(" | ") %>
  <title><%= title %></title>
  <meta property="og:title" content="<%= current_article ? current_article.title : title %>"/>

  <% description_default = "Fight climate change: make the pledge to be flight free in 2026" %>
  <%- 
  if current_article
    sm_image = current_article.data.cover_image
    description = current_article.data.summary
  else
    # cover image
    if current_page && current_page.data.cover_image
      sm_image = current_page.data.cover_image
    else
      sm_image = "/images/flight-free-pledge-2026.jpg"
    end
    # description
    if current_page && current_page.data.summary
      description = current_page.data.summary
    else
      description = description_default
    end
  end -%>

  <meta name="description" content="<%= description %>"/>
  <meta property="og:description" content="<%= description %>"/>

  <meta property="og:type" content="<%= current_article ? "article" : "website" %>"/>
  <meta property="og:image" content="https://flightfree.co.uk<%= sm_image %>"/>
  <meta property="og:image:alt" content="<%= description %>"/>

  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:site" content="<%= data.social_media.twitter %>" />
  <meta name="twitter:title" content="<%= current_article ? current_article.title : title %>" />
  <meta name="twitter:description" content="<%= description %>" />
  <meta name="twitter:image" content="https://flightfree.co.uk<%= sm_image %>" />

  <%= stylesheet_link_tag "main" %>

<%# start brevo_form_css %>
    <%= partial "brevo_form_css" %>
<%# end brevo_form_css %>

  <!-- Donorbox code -->
  <script type="text/javascript" defer src="https://donorbox.org/install-popup-button.js"></script>
  <script>window.DonorBox = { widgetLinkClassName: 'custom-dbox-popup' }</script>
  <!-- End Donorbox code -->

</head>
<body class="font-body">
<%# annual fundraising banner...
<div class="section--banner bg-blue-dark text-gray-light">
    <a href="https://donorbox.org/the-flight-free-uk-annual-fundraiser-2024" class="block mx-0 px-2 py-6 hover:text-orange">
        <p class="text-center italic text-xl xl:text-3xl xl:mb-1">Our annual fundraiser is <span class="text-orange">LIVE</span>! Click here to go to our fundraiser page</p>
    </a>
</div>
 #%>

<%= yield %>

<%# start footer %>
    <%= partial "footer" %>
<%# end footer %>

<%= javascript_include_tag "main.js" %>

<%# start brevo_form_javascript %>
    <%= partial "brevo_form_javascript" %>
<%# end brevo_form_javascript %>

<% if current_page.path == 'index.html' %>
<%# start fundraiser_modal %>
    <%# partial "fundraiser_modal" %>
<%# end fundraiser_modal %>
<% end %>

</body>
</html>